{
  "name": "@prose-reader/koreader",
  "version": "34.0.0",
  "description": "Convert reading positions between EPUB CFIs and KOReader's crengine XPointers, and compute the document digests KOReader sync uses.",
  "keywords": [
    "prose-reader",
    "koreader",
    "kosync",
    "xpointer",
    "crengine",
    "epubcfi",
    "epub"
  ],
  "homepage": "https://doc.prose-reader.com/koreader",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbret/prose-reader.git",
    "directory": "packages/koreader"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "/dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "start": "vite build --watch --mode development",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "tsc": "tsc"
  },
  "dependencies": {
    "@prose-reader/cfi": "workspace:^",
    "@prose-reader/shared": "workspace:^"
  },
  "devDependencies": {
    "jszip": "^3.10.1",
    "typescript": "*",
    "vite": "^8"
  }
}
