{
  "name": "@prose-reader/enhancer-koreader",
  "version": "36.0.0",
  "description": "KOReader sync for prose: open a reader at the progress a KOReader sync server stores, go to it, and convert a CFI to it.",
  "keywords": [
    "prose-reader",
    "koreader",
    "kosync",
    "reading-progress",
    "sync",
    "xpointer",
    "epub"
  ],
  "homepage": "https://doc.prose-reader.com/enhancers/koreader",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbret/prose-reader.git",
    "directory": "packages/enhancer-koreader"
  },
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "start": "vite build --watch --mode development",
    "build": "tsc && vite build",
    "tsc": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@prose-reader/koreader": "workspace:^",
    "@prose-reader/shared": "workspace:^"
  },
  "peerDependencies": {
    "@prose-reader/core": "workspace:^"
  },
  "devDependencies": {
    "@prose-reader/archive-reader": "workspace:^",
    "@prose-reader/cbz": "workspace:^",
    "@prose-reader/streamer": "workspace:^",
    "rxjs": "^7.5.5"
  }
}
