      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "start": "vite build --watch --mode development",
    "build": "tsc && vite build",
    "tsc": "tsc"
  },
  "dependencies": {
    "@prose-reader/koreader": "workspace:^",
    "@prose-reader/shared": "workspace:^"
  },
  "peerDependencies": {
    "@prose-reader/core": "workspace:^",
    "rxjs": "^7.2.0"
  }
}
