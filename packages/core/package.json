{
  "name": "@prose-reader/core",
  "version": "14.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "files": [
    "/dist"
  ],
  "scripts": {
    "start": "vite build --watch --mode development",
    "build": "tsc && vite build",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch",
    "tsc": "tsc"
  },
  "dependencies": {
    "@prose-reader/cfi": "workspace:^",
    "@prose-reader/shared": "workspace:^"
  },
  "peerDependencies": {
    "rxjs": "^7.2.0"
  },
  "devDependencies": {
    "happy-dom": "*",
    "sass-embedded": "^1.102.0"
  },
  "madge": {
    "detectiveOptions": {
      "ts": {
        "skipTypeImports": true
      }
    }
  },
