{
  "name": "@prose-reader/streamer",
  "version": "45.0.0",
  "description": "Turn a book archive into the manifest prose reads and serve its resources, from a service worker, Node or React Native.",
  "keywords": [
    "prose-reader",
    "epub",
    "streamer",
    "service-worker",
    "manifest",
    "comics",
    "ebook"
  ],
  "homepage": "https://doc.prose-reader.com/learn/streamer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbret/prose-reader.git",
    "directory": "packages/streamer"
  },
  "type": "module",
  "main": "./dist/index/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "files": [
    "/dist"
  ],
  "scripts": {
    "start": "node ../../config/watchLibraryBuild.mjs",
    "build": "tsc && vite build && tsc -p tsconfig.build.json",
    "test": "vitest run --coverage",
    "tsc": "tsc",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@prose-reader/archive-reader": "workspace:^",
    "@prose-reader/shared": "workspace:^",
    "xmldoc": "^3.0.0"
  },
  "peerDependencies": {
    "rxjs": "^7.5.5"
  },
  "gitHead": "4601e14dcacf50b2295cb343582a7ef2c7e1eedc",
  "engines": {
    "node": ">=22.12"
  }
}
