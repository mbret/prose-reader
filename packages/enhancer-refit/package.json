{
  "name": "@prose-reader/enhancer-refit",
  "version": "30.0.0",
  "description": "Fit the reading area of a prose reader to a desktop, tablet or custom width when a book scrolls.",
  "keywords": [
    "prose-reader",
    "viewport",
    "webtoon",
    "comics",
    "scrolling",
    "ebook"
  ],
  "homepage": "https://doc.prose-reader.com/enhancers/refit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbret/prose-reader.git",
    "directory": "packages/enhancer-refit"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "start": "vite build --watch --mode development",
    "build": "tsc && vite build"
  },
  "peerDependencies": {
    "@prose-reader/core": "workspace:^",
    "rxjs": "^7.5.5"
  }
}
