{
  "name": "@prose-reader/cfi",
  "version": "47.0.0",
  "description": "Parse, resolve, generate, compare and serialize EPUB Canonical Fragment Identifiers (EPUB CFI 1.1).",
  "keywords": [
    "prose-reader",
    "epub",
    "epubcfi",
    "cfi",
    "canonical-fragment-identifier",
    "ebook"
  ],
  "homepage": "https://doc.prose-reader.com/cfi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbret/prose-reader.git",
    "directory": "packages/cfi"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "/dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "start": "node ../../config/watchLibraryBuild.mjs",
    "build": "tsc && vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "*",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.12"
  }
}
