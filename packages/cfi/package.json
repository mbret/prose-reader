{
  "name": "@prose-reader/cfi",
  "version": "30.0.0",
  "description": "Parse, resolve, generate, compare and serialize EPUB Canonical Fragment Identifiers (EPUB CFI 1.1).",
  "keywords": [
    "prose-reader",
    "epub",
    "epubcfi",
    "cfi",
    "canonical-fragment-identifier",
    "ebook"
  ],
  "homepage": "https://doc.prose-reader.com/cfi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbret/prose-reader.git",
    "directory": "packages/cfi"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "/dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "start": "vite build --watch --mode development",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "*",
    "vite": "^8"
  }
}
