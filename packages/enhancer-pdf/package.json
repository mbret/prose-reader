{
  "name": "@prose-reader/enhancer-pdf",
  "version": "36.0.0",
  "description": "PDF in prose: open a PDF as an archive and render its pages with pdf.js.",
  "keywords": [
    "prose-reader",
    "pdf",
    "pdfjs",
    "pdf-viewer",
    "ebook",
    "reader"
  ],
  "homepage": "https://doc.prose-reader.com/enhancers/pdf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbret/prose-reader.git",
    "directory": "packages/enhancer-pdf"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "start": "vite build --watch --mode development",
    "build": "tsc && vite build"
  },
  "devDependencies": {
    "pdfjs-dist": "^6.2.108"
  },
  "peerDependencies": {
    "@prose-reader/archive-reader": "workspace:^",
    "@prose-reader/core": "workspace:^",
    "pdfjs-dist": ">=6.2.108 <7",
    "rxjs": "^7.5.5"
  }
}
