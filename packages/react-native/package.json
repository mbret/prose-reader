{
  "name": "@prose-reader/react-native",
  "version": "45.0.0",
  "description": "Run prose in a React Native WebView: bridge the reader to your app, drive it from native code, and serve books with Expo.",
  "keywords": [
    "prose-reader",
    "react-native",
    "expo",
    "webview",
    "epub",
    "ebook",
    "reader"
  ],
  "homepage": "https://doc.prose-reader.com/react-native/prose-reader-react-native",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbret/prose-reader.git",
    "directory": "packages/react-native"
  },
  "type": "module",
  "main": "./dist/native/index.js",
  "types": "./dist/native/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    }
  },
  "license": "MIT",
  "files": [
    "/dist"
  ],
  "scripts": {
    "start": "node ../../config/watchLibraryBuild.mjs",
    "build": "vite build && tsc -p tsconfig.build.json",
    "tsc": "tsc --noEmit -p tsconfig.rn.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "expo": "^58.0.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-webview": "14.0.1"
  },
  "peerDependencies": {
    "@prose-reader/archive-reader": "workspace:^",
    "@prose-reader/core": "workspace:^",
    "@prose-reader/shared": "workspace:^",
    "@prose-reader/streamer": "workspace:^",
    "@webview-bridge/react-native": "^1.7.7",
    "@webview-bridge/web": "^1.7.7",
    "expo-file-system": "^58.0.0",
    "react": "19.x",
    "react-native-webview": "*",
    "rxjs": "^7.5.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
