{
  "name": "@prose-reader/cbz",
  "version": "30.2.0",
  "description": "Comic archives in prose: streamer hooks and a reader enhancer for CBZ files, with spread splitting and right-to-left manga.",
  "keywords": [
    "prose-reader",
    "cbz",
    "cbr",
    "comics",
    "manga",
    "comic-book",
    "ebook",
    "reader"
  ],
  "homepage": "https://doc.prose-reader.com/enhancers/cbz-and-comics-archives",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbret/prose-reader.git",
    "directory": "packages/cbz"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "/dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "start": "vite build --watch --mode development",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "*",
    "vite": "^8"
  },
  "peerDependencies": {
    "@prose-reader/archive-reader": "workspace:^",
    "@prose-reader/cfi": "workspace:^",
    "@prose-reader/core": "workspace:^",
    "@prose-reader/shared": "workspace:^",
    "@prose-reader/streamer": "workspace:^"
  }
}
