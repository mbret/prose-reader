{
  "name": "@prose-reader/metadata-fetcher",
  "version": "34.0.0",
  "description": "Look up a book's metadata in Google Books, Open Library and Project Gutenberg, and rank the matches, in Node or as an HTTP service.",
  "keywords": [
    "prose-reader",
    "book-metadata",
    "google-books",
    "open-library",
    "project-gutenberg",
    "isbn",
    "ebook"
  ],
  "homepage": "https://doc.prose-reader.com/metadata-fetcher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbret/prose-reader.git",
    "directory": "packages/metadata-fetcher"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "prose-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "license": "MIT",
  "files": [
    "/dist"
  ],
  "scripts": {
    "start": "vite build --watch --mode development",
    "build": "tsc && vite build",
    "test": "vitest run --coverage",
    "tsc": "tsc",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@prose-reader/archive-reader": "workspace:^",
    "@prose-reader/shared": "workspace:^",
    "xmldoc": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
