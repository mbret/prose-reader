{
  "name": "@prose-reader/archive-reader",
  "version": "36.0.0",
  "description": "Read EPUB, CBZ, CBR and text files as archives, and resolve their metadata, cover, reading order and table of contents.",
  "keywords": [
    "prose-reader",
    "epub",
    "cbz",
    "cbr",
    "comics",
    "archive",
    "zip",
    "ebook",
    "metadata",
    "comicinfo"
  ],
  "homepage": "https://doc.prose-reader.com/archive-reader",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbret/prose-reader.git",
    "directory": "packages/archive-reader"
  },
  "type": "module",
  "main": "./dist/index/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "prose-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index/index.js"
    },
    "./archives/createArchiveFromJszip": {
      "prose-source": "./src/archives/createArchiveFromJszip.ts",
      "types": "./dist/archives/createArchiveFromJszip.d.ts",
      "default": "./dist/archives/createArchiveFromJszip/index.js"
    },
    "./archives/createArchiveFromLibArchive": {
      "prose-source": "./src/archives/createArchiveFromLibArchive.ts",
      "types": "./dist/archives/createArchiveFromLibArchive.d.ts",
      "default": "./dist/archives/createArchiveFromLibArchive/index.js"
    },
    "./archives/createArchiveFromUnzipper": {
      "prose-source": "./src/archives/createArchiveFromUnzipper.ts",
      "types": "./dist/archives/createArchiveFromUnzipper.d.ts",
      "default": "./dist/archives/createArchiveFromUnzipper/index.js"
    },
    "./archives/createArchiveFromNodeUnrarJs": {
      "prose-source": "./src/archives/createArchiveFromNodeUnrarJs.ts",
      "types": "./dist/archives/createArchiveFromNodeUnrarJs.d.ts",
      "default": "./dist/archives/createArchiveFromNodeUnrarJs/index.js"
    },
    "./archives/createArchiveFromZipJs": {
      "prose-source": "./src/archives/createArchiveFromZipJs.ts",
      "types": "./dist/archives/createArchiveFromZipJs.d.ts",
      "default": "./dist/archives/createArchiveFromZipJs/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "files": [
    "/dist"
  ],
  "scripts": {
    "start": "node ../../config/watchLibraryBuild.mjs",
    "build": "tsc && vite build && tsc -p tsconfig.build.json",
    "test": "vitest run --coverage",
    "tsc": "tsc",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@prose-reader/shared": "workspace:^",
    "xmldoc": "^3.0.0"
  },
  "peerDependencies": {
    "@zip.js/zip.js": "^2.8.33",
    "buffer": "^6.0.3",
    "jszip": "^3.10.0",
    "libarchive.js": "^2.0.2",
    "node-unrar-js": "^2.0.2",
    "unzipper": "^0.12.3"
  },
  "peerDependenciesMeta": {
    "@zip.js/zip.js": {
      "optional": true
    },
    "buffer": {
      "optional": true
    },
    "jszip": {
      "optional": true
    },
    "unzipper": {
      "optional": true
    },
    "libarchive.js": {
      "optional": true
    },
    "node-unrar-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/sax": "^1.2.7",
    "@types/unzipper": "^0.10.11",
    "@zip.js/zip.js": "^2.25.0",
    "buffer": "^6.0.3",
    "jszip": "^3.10.2",
    "libarchive.js": "^2.0.2",
    "node-unrar-js": "^2.0.2",
    "unzipper": "^0.12.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
