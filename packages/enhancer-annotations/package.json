{
  "name": "@prose-reader/enhancer-annotations",
  "version": "30.2.0",
  "description": "Highlights and notes for prose: create annotations anchored by CFIs, show their highlights in the book and react to taps on them.",
  "keywords": [
    "prose-reader",
    "annotations",
    "highlights",
    "notes",
    "epub",
    "cfi",
    "ebook"
  ],
  "homepage": "https://doc.prose-reader.com/enhancers/annotations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbret/prose-reader.git",
    "directory": "packages/enhancer-annotations"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "start": "vite build --watch --mode development",
    "build": "tsc && vite build"
  },
  "peerDependencies": {
    "@prose-reader/core": "workspace:^",
    "@prose-reader/shared": "workspace:^",
    "rxjs": "^7.5.5"
  }
}
