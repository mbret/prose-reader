{
  "name": "prose-react-native-demo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "npm run web:build && expo start",
    "start:all": "npm run web:build && concurrently \"expo start\" \"vite build web --watch\"",
    "android": "npm run web:build && expo run:android",
    "ios": "npm run web:build && expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "web:preview": "vite preview web",
    "bundle": "npm run web:build && expo export --platform ios && expo export --platform android"
  },
  "overrides": {
    "decode-uri-component@^0.2.2": "^0.5.0",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@prose-reader/archive-reader": "file:../packages/archive-reader",
    "@prose-reader/core": "file:../packages/core",
    "@prose-reader/react-native": "file:../packages/react-native",
    "@prose-reader/shared": "file:../packages/shared",
    "@prose-reader/streamer": "file:../packages/streamer",
    "@webview-bridge/react-native": "^1.7.7",
    "@webview-bridge/web": "^1.7.7",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-native-zip-archive": "^7.0.1",
    "rxjs": "^7.8.2",
    "xmldoc": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vite": "^8",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "private": true
}
