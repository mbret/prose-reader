{
  "name": "prose-react-native-demo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "npm run web:build && expo start",
    "start:all": "npm run web:build && concurrently \"expo start\" \"vite build web --watch\"",
    "android": "npm run web:build && expo run:android",
    "ios": "npm run web:build && expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "web:preview": "vite preview web",
    "bundle": "npm run web:build && expo export --platform ios && expo export --platform android"
  },
  "overrides": {
    "decode-uri-component@^0.2.2": "^0.5.0",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@prose-reader/archive-reader": "file:../packages/archive-reader",
    "@prose-reader/core": "file:../packages/core",
    "@prose-reader/react-native": "file:../packages/react-native",
    "@prose-reader/shared": "file:../packages/shared",
    "@prose-reader/streamer": "file:../packages/streamer",
    "@webview-bridge/react-native": "^1.7.7",
    "@webview-bridge/web": "^1.7.7",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-native-zip-archive": "^9.5.3",
    "rxjs": "^7.8.2",
    "xmldoc": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "vite": "^8",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "private": true
}
