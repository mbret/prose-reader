{
  "name": "@prose-reader/root",
  "private": true,
  "version": "1.0.0",
  "main": "index.js",
  "author": "Maxime Bret <bret.maxime@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "start": "lerna run start --stream",
    "start:lib": "lerna run start --stream --scope @prose-reader/* --concurrency 15",
    "start:front": "lerna run start --stream --scope prose-reader-front",
    "start:metadata-fetcher": "docker compose -f apps/metadata-fetcher-api/docker-compose.yml up --build",
    "stop:metadata-fetcher": "docker compose -f apps/metadata-fetcher-api/docker-compose.yml down",
    "build": "lerna run build --stream",
    "build:lib": "lerna run build --stream --scope @prose-reader/*",
    "check:react-reader-enhancers": "pnpm --filter @prose-reader/react-reader run check:enhancers",
    "tsc": "lerna run tsc --parallel && tsc -p tsconfig.configs.json",
    "format": "biome format .",
    "lint": "biome lint .",
    "check:agent-docs": "node scripts/check-agent-docs.mjs",
    "test": "lerna run test --parallel",
    "test:scripts": "node --test scripts/*.test.mjs",
    "prepare": "husky",
    "check:internal-ranges": "node scripts/check-internal-ranges.mjs",
    "check:expo-sdk": "CI=1 EXPO_OFFLINE=1 pnpm --filter @prose-reader/react-native exec expo install --check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.11",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "husky": "^9.1.7",
    "lerna": "^9.0.7",
    "lint-staged": "^17.0.5",
    "rollup-plugin-node-externals": "^9.0.0",
    "typescript": "^6.0.0",
    "vite": "^8",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true --write"
    ]
  }
}
