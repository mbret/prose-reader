# Copy this file to `.env`. Docker Compose loads it automatically when
# `npm run start:metadata-fetcher` is run from the repository root.

# Enables the Google Books provider.
GOOGLE_BOOKS_API_KEY=

# Optional development overrides.
# METADATA_FETCHER_PORT=3000
# GOOGLE_BOOKS_BASE_URL=https://www.googleapis.com/books/v1
# PROJECT_GUTENBERG_USER_AGENT=prose-reader-metadata-fetcher-api (development)
# OPEN_LIBRARY_USER_AGENT=prose-reader-metadata-fetcher-api (development)
# METADATA_LIMIT=5
# METADATA_MIN_SCORE=0.5
# REQUEST_TIMEOUT_MS=10000
